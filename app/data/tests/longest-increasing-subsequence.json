{
  "slug": "longest-increasing-subsequence",
  "driver": "function",
  "class": "Solution",
  "method": "lengthOfLIS",
  "params": [{"name": "nums", "type": "int[]"}],
  "returns": "int",
  "compare": "exact",
  "time_limit_s": 2.0,
  "cases": [
    {"name": "Example 1", "example": true, "args": [[10, 9, 2, 5, 3, 7, 101, 18]], "expected": 4},
    {"name": "Example 2", "example": true, "args": [[0, 1, 0, 3, 2, 3]], "expected": 4},
    {"name": "Example 3", "example": true, "args": [[7, 7, 7, 7, 7, 7, 7]], "expected": 1},
    {"name": "Single element", "args": [[5]], "expected": 1},
    {"name": "Already increasing", "args": [[1, 2, 3, 4, 5]], "expected": 5},
    {"name": "Decreasing", "args": [[5, 4, 3, 2, 1]], "expected": 1},
    {"name": "Two equal", "args": [[2, 2]], "expected": 1},
    {"name": "Duplicates inside", "args": [[4, 10, 4, 3, 8, 9]], "expected": 3},
    {"name": "Gaps", "args": [[1, 3, 6, 7, 9, 4, 10, 5, 6]], "expected": 6},
    {"name": "Negatives", "args": [[-2, -1]], "expected": 2},
    {"name": "Zigzag", "args": [[3, 5, 6, 2, 5, 4, 19, 5, 6, 7, 12]], "expected": 6},
    {"name": "Extreme values", "args": [[10000, -10000]], "expected": 1},
    {"name": "Large input", "args": [{"$lcg": {"n": 2500, "lo": -10000, "hi": 10000, "seed": 2}}], "expected": 97},
    {"name": "Large increasing", "args": [{"$range": [-1250, 1250, 1]}], "expected": 2500}
  ]
}
