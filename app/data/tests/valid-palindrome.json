{
  "slug": "valid-palindrome",
  "driver": "function",
  "class": "Solution",
  "method": "isPalindrome",
  "params": [{"name": "s", "type": "str"}],
  "returns": "bool",
  "compare": "exact",
  "time_limit_s": 2.0,
  "cases": [
    {"name": "Example 1", "example": true, "args": ["A man, a plan, a canal: Panama"], "expected": true},
    {"name": "Example 2", "example": true, "args": ["race a car"], "expected": false},
    {"name": "Example 3", "example": true, "args": [" "], "expected": true},
    {"name": "Single letter", "args": ["a"], "expected": true},
    {"name": "Single space", "args": [" "], "expected": true},
    {"name": "Only symbols", "args": [".,"], "expected": true},
    {"name": "Two different letters", "args": ["ab"], "expected": false},
    {"name": "Mixed case pair", "args": ["Aa"], "expected": true},
    {"name": "Letter and digit", "args": ["0P"], "expected": false},
    {"name": "Digits", "args": ["12321"], "expected": true},
    {"name": "Underscore ignored", "args": ["ab_a"], "expected": true},
    {"name": "Symbols between letters", "args": ["ab@#ba"], "expected": true},
    {"name": "Skipped symbol changes the answer", "args": ["a.b"], "expected": false},
    {"name": "Spaces and case", "args": ["  Was it a car or a cat I saw?  "], "expected": true},
    {"name": "Long palindrome", "args": [{"$str": {"chars": "a", "n": 200000, "seed": 1}}], "expected": true},
    {"name": "Long non-palindrome", "args": [{"$str": {"chars": "ab", "n": 200000, "seed": 1}}], "expected": false}
  ]
}
