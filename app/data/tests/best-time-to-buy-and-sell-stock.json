    {"name": "Single day", "args": [[5]], "expected": 0},
    {"name": "Equal prices", "args": [[5, 5]], "expected": 0},
    {"name": "Two rising days", "args": [[1, 2]], "expected": 1},
    {"name": "Two falling days", "args": [[2, 1]], "expected": 0},
    {"name": "Low price after the best sale", "args": [[2, 4, 1]], "expected": 2},
    {"name": "Best low is not the first", "args": [[3, 2, 6, 5, 0, 3]], "expected": 4},
    {"name": "Extreme values", "args": [[0, 10000]], "expected": 10000},
    {"name": "Highest price before lowest", "args": [[10000, 0, 10000]], "expected": 10000},
    {"name": "Price drops after a peak", "args": [[1, 10, 0, 5]], "expected": 9},
    {"name": "Lowest price last", "args": [[3, 3, 3, 0]], "expected": 0},
