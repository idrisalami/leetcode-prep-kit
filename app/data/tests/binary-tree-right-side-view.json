    {"name": "Example 3", "example": true, "args": [[1, null, 3]], "expected": [1, 3]},
    {"name": "Example 4", "example": true, "args": [[]], "expected": []},
    {"name": "Empty tree", "args": [[]], "expected": []},
    {"name": "Single node", "args": [[1]], "expected": [1]},
    {"name": "Left subtree is deeper", "args": [[1, 2, 3, 4, 5, null, null, 6]], "expected": [1, 3, 5, 6]},
    {"name": "Left chain", "args": [[1, 2, null, 3, null, 4]], "expected": [1, 2, 3, 4]},
    {"name": "Right chain", "args": [[1, null, 2, null, 3]], "expected": [1, 2, 3]},
