{
  "slug": "regular-expression-matching",
  "driver": "function",
  "class": "Solution",
  "method": "isMatch",
  "params": [{"name": "s", "type": "str"}, {"name": "p", "type": "str"}],
  "returns": "bool",
  "compare": "exact",
  "time_limit_s": 2.0,
  "cases": [
    {"name": "Example 1", "example": true, "args": ["aa", "a"], "expected": false},
    {"name": "Example 2", "example": true, "args": ["aa", "a*"], "expected": true},
    {"name": "Example 3", "example": true, "args": ["ab", ".*"], "expected": true},
    {"name": "Single match", "args": ["a", "a"], "expected": true},
    {"name": "Single miss", "args": ["a", "b"], "expected": false},
    {"name": "Dot", "args": ["a", "."], "expected": true},
    {"name": "Pattern too short", "args": ["ab", "a"], "expected": false},
    {"name": "Star matches nothing", "args": ["aab", "c*a*b"], "expected": true},
    {"name": "Mississippi miss", "args": ["mississippi", "mis*is*p*."], "expected": false},
    {"name": "Mississippi hit", "args": ["mississippi", "mis*is*ip*."], "expected": true},
    {"name": "Dot star then letter", "args": ["ab", ".*c"], "expected": false},
    {"name": "Star then absent", "args": ["a", "ab*"], "expected": true},
    {"name": "Star gives back", "args": ["a", "a*a"], "expected": true},
    {"name": "Star gives back more", "args": ["aaa", "a*a"], "expected": true},
    {"name": "Several stars", "args": ["aaa", "ab*a*c*a"], "expected": true},
    {"name": "Star on other letter", "args": ["a", "b*"], "expected": false},
    {"name": "Letter after dot star", "args": ["bbbba", ".*a*a"], "expected": true},
    {"name": "Short text long pattern", "args": ["a", "a*a*a*a*a*a*a*a*a*a*"], "expected": true},
    {"name": "Dot star after letter", "args": ["a", "a.*"], "expected": true},
    {"name": "Dot star after text", "args": ["ab", "ab.*"], "expected": true},
    {"name": "Many stars", "args": ["aaaaaaaaaaaaaaaaaaaa", "a*a*a*a*a*a*a*a*a*c"], "expected": false},
    {"name": "Many dot stars", "args": ["aaaaaaaaaaaaaaaaaaab", ".*.*.*.*.*.*.*.*.*c"], "expected": false}
  ]
}
