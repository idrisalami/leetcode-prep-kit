{
  "slug": "longest-consecutive-sequence",
  "driver": "function",
  "class": "Solution",
  "method": "longestConsecutive",
  "params": [{"name": "nums", "type": "int[]"}],
  "returns": "int",
  "compare": "exact",
  "time_limit_s": 2.0,
  "cases": [
    {"name": "Example 1", "example": true, "args": [[100, 4, 200, 1, 3, 2]], "expected": 4},
    {"name": "Example 2", "example": true, "args": [[0, 3, 7, 2, 5, 8, 4, 6, 0, 1]], "expected": 9},
    {"name": "Example 3", "example": true, "args": [[1, 0, 1, 2]], "expected": 3},
    {"name": "Empty array", "args": [[]], "expected": 0},
    {"name": "Single element", "args": [[5]], "expected": 1},
    {"name": "All equal", "args": [[1, 1, 1]], "expected": 1},
    {"name": "Negatives through zero", "args": [[-3, -2, -1, 0, 1]], "expected": 5},
    {"name": "No neighbours", "args": [[10, 20, 30]], "expected": 1},
    {"name": "Descending run", "args": [[5, 4, 3, 2, 1]], "expected": 5},
    {"name": "Extreme values apart", "args": [[-1000000000, 1000000000]], "expected": 1},
    {"name": "Extreme values adjacent", "args": [[-1000000000, -999999999]], "expected": 2},
    {"name": "Two equal runs", "args": [[1, 2, 3, 10, 11, 12]], "expected": 3},
    {"name": "Duplicates inside run", "args": [[1, 2, 2, 3, 3, 4]], "expected": 4},
    {"name": "Run after a gap", "args": [[9, 1, 4, 7, 3, -1, 0, 5, 8, -2, -4]], "expected": 4},
    {"name": "Large input", "args": [{"$range": [0, 100000, 1]}], "expected": 100000},
    {"name": "Large reversed input", "args": [{"$range": [100000, 0, -1]}], "expected": 100000},
    {"name": "Large random input", "args": [{"$lcg": {"n": 100000, "lo": -1000000000, "hi": 1000000000, "seed": 5}}], "expected": 2}
  ]
}
